# Vertex AI Application Default Credentials (ADC) Configuration
# Run `gcloud auth application-default login` before starting the agent.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional: Set when deploying the MCP server separately on Cloud Run (StreamableHTTP)
# MCP_SERVER_URL=https://travel-mcp-xxxx.a.run.app/mcp
